# ==============================================================================
# Agentic API Security Proxy - Local Environment Configuration Example
#
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT OVERRIDES.
# NEVER COMMIT ACTUAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Proxy Gateway Network Configuration
# ------------------------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8000

# Base URL pointing to the protected upstream mock backend
# In local development: http://127.0.0.1:8001
# In Docker Compose:    http://upstream:8001
UPSTREAM_BASE_URL=http://127.0.0.1:8001

# Connection and response timeouts in seconds
UPSTREAM_CONNECT_TIMEOUT_SEC=2.0
UPSTREAM_READ_TIMEOUT_SEC=5.0

# ------------------------------------------------------------------------------
# Internal Service Authentication
# ------------------------------------------------------------------------------
# Shared development service credential for authenticating proxy-to-upstream communication.
# WARNING: This static value is for local development and academic evaluation only.
INTERNAL_SERVICE_KEY=dev-proxy-internal-service-key-998877

# ------------------------------------------------------------------------------
# Database Paths
# ------------------------------------------------------------------------------
# In local development: relative to project root
# In Docker Compose:    persisted in container volume (/data)
AUDIT_DB_PATH=audit_log.db
UPSTREAM_DB_PATH=synthetic_upstream.db
